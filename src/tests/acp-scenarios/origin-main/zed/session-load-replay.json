[
  {
    "kind": "initialize",
    "payload": {
      "protocolVersion": 1,
      "agentCapabilities": {
        "_meta": {
          "claudeCode": {
            "promptQueueing": true
          },
          "authStatus": {}
        },
        "promptCapabilities": {
          "image": true,
          "embeddedContext": true
        },
        "mcpCapabilities": {
          "http": true,
          "sse": true
        },
        "auth": {
          "logout": {}
        },
        "providers": {},
        "loadSession": true,
        "sessionCapabilities": {
          "additionalDirectories": {},
          "close": {},
          "delete": {},
          "fork": {},
          "list": {},
          "resume": {},
          "subagents": {}
        }
      },
      "agentInfo": {
        "name": "@agentclientprotocol/claude-agent-acp",
        "title": "Claude Agent",
        "version": "<version>"
      },
      "authMethods": [
        {
          "description": "Use Claude subscription ",
          "name": "Claude Subscription",
          "id": "claude-ai-login",
          "type": "terminal",
          "args": [
            "<argv>",
            "--cli",
            "auth",
            "login",
            "--claudeai"
          ],
          "_meta": {
            "terminal-auth": {
              "command": "<executable>",
              "args": [
                "<argv>",
                "--cli",
                "auth",
                "login",
                "--claudeai"
              ],
              "label": "Claude Login"
            }
          }
        },
        {
          "description": "Use Anthropic Console (API usage billing)",
          "name": "Anthropic Console",
          "id": "console-login",
          "type": "terminal",
          "args": [
            "<argv>",
            "--cli",
            "auth",
            "login",
            "--console"
          ],
          "_meta": {
            "terminal-auth": {
              "command": "<executable>",
              "args": [
                "<argv>",
                "--cli",
                "auth",
                "login",
                "--console"
              ],
              "label": "Anthropic Console Login"
            }
          }
        }
      ],
      "_meta": {
        "jetbrains": {
          "air": {
            "version": 1,
            "capabilities": [
              "sessionFailure",
              "agentFileChangeReport",
              "nativeSubagentSessions",
              "asyncTasks",
              "recommendedValue"
            ]
          }
        },
        "steering": {
          "supported": true
        },
        "goal": {
          "version": 1,
          "controlMethod": "_session/goal",
          "actions": [
            "set",
            "clear"
          ]
        }
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "sessionUpdate": "user_message_chunk",
        "content": {
          "type": "text",
          "text": "Fix the bug"
        },
        "messageId": "<id-1>"
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "sessionUpdate": "agent_thought_chunk",
        "content": {
          "type": "text",
          "text": "Check the file."
        },
        "messageId": "msg_r1"
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "sessionUpdate": "agent_message_chunk",
        "content": {
          "type": "text",
          "text": "I will edit it."
        },
        "messageId": "msg_r1"
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "_meta": {
          "claudeCode": {
            "toolName": "Bash",
            "title": "List"
          },
          "terminal_info": {
            "terminal_id": "toolu_r_bash"
          }
        },
        "toolCallId": "toolu_r_bash",
        "sessionUpdate": "tool_call",
        "name": "Bash",
        "rawInput": {
          "command": "ls",
          "description": "List"
        },
        "status": "pending",
        "title": "ls",
        "kind": "execute",
        "content": [
          {
            "type": "terminal",
            "terminalId": "toolu_r_bash"
          }
        ]
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "_meta": {
          "claudeCode": {
            "toolName": "Edit"
          }
        },
        "toolCallId": "toolu_r_edit",
        "sessionUpdate": "tool_call",
        "name": "Edit",
        "rawInput": {
          "file_path": "<cwd>/src/app.ts",
          "old_string": "a",
          "new_string": "b"
        },
        "status": "pending",
        "title": "Edit src/app.ts",
        "kind": "edit",
        "content": [
          {
            "type": "diff",
            "path": "<cwd>/src/app.ts",
            "oldText": "a",
            "newText": "b"
          }
        ],
        "locations": [
          {
            "path": "<cwd>/src/app.ts"
          }
        ]
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "_meta": {
          "claudeCode": {
            "toolName": "Task",
            "subagent": true
          }
        },
        "toolCallId": "toolu_r_task",
        "sessionUpdate": "tool_call",
        "name": "Task",
        "rawInput": {
          "description": "Explore",
          "prompt": "Look around"
        },
        "status": "pending",
        "title": "Explore",
        "kind": "think",
        "content": [
          {
            "type": "content",
            "content": {
              "type": "text",
              "text": "Look around"
            }
          }
        ]
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "_meta": {
          "terminal_output": {
            "terminal_id": "toolu_r_bash",
            "data": "app.ts"
          }
        },
        "toolCallId": "toolu_r_bash",
        "sessionUpdate": "tool_call_update"
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "_meta": {
          "claudeCode": {
            "toolName": "Bash"
          },
          "terminal_exit": {
            "terminal_id": "toolu_r_bash",
            "exit_code": 0,
            "signal": null
          }
        },
        "toolCallId": "toolu_r_bash",
        "sessionUpdate": "tool_call_update",
        "status": "completed",
        "content": [
          {
            "type": "terminal",
            "terminalId": "toolu_r_bash"
          }
        ]
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "_meta": {
          "claudeCode": {
            "toolName": "Edit"
          }
        },
        "toolCallId": "toolu_r_edit",
        "sessionUpdate": "tool_call_update",
        "status": "completed",
        "rawOutput": "The file <cwd>/src/app.ts has been updated successfully."
      }
    }
  },
  {
    "kind": "sessionUpdate",
    "payload": {
      "sessionId": "<session>",
      "update": {
        "_meta": {
          "claudeCode": {
            "toolName": "Task"
          }
        },
        "toolCallId": "toolu_r_task",
        "sessionUpdate": "tool_call_update",
        "status": "completed",
        "rawOutput": "Report.",
        "content": [
          {
            "type": "content",
            "content": {
              "type": "text",
              "text": "Report."
